---
import Base from '../layouts/Base.astro';
import { research, publications } from '../data/lab';
const worksFor = (id: string) => publications.filter(paper => paper.topics?.includes(id));
---
<Base title="Research" description="Generative world models for science and health: research topics and related work at SWI Lab, Georgia Tech.">
  <div class="container">
    <header class="page-heading-simple">
      <h1>Research</h1>
      <p class="lead">We build world models—generative, predictive models of how things look, move, and evolve—and use them to solve inference problems in the physical and living world. One model serves two directions: run forward, it simulates and generates; run in reverse, it infers what produced a partial, noisy measurement.</p>
    </header>

    {research.map(topic => {
      const works = worksFor(topic.id);
      return (
        <section id={topic.id} class="research-section section-anchor">
          <h2>{topic.title}</h2>
          <div class="research-body">
            <p class="research-description">{topic.description}</p>
            <ul class="tag-list" aria-label="Keywords">{topic.tags.map(tag => <li>{tag}</li>)}</ul>
            <h3 class="related-title">Related work</h3>
            {works.length > 0 ? (
              <ol class="related-work">
                {works.map(paper => (
                  <li>
                    <a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title}</a>
                    <span class="related-meta">{paper.venue} {paper.year}{paper.code && <> · <a href={paper.code} target="_blank" rel="noopener noreferrer">code</a></>}</span>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="related-empty">Coming soon.</p>
            )}
          </div>
        </section>
      );
    })}

    <div class="research-bottom"><a href="/publications/">All publications</a><a href="/join/">Join us</a></div>
  </div>
</Base>
