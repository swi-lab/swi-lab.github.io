---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const intro = await getEntry('pages', 'research');
const { Content: Intro } = intro ? await render(intro) : { Content: null };
const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(topics.map(async topic => ({ topic, Content: (await render(topic)).Content })));
---
<Base title="Research" description="Generative and world models, agentic and self-improving systems, and science and medicine: research and representative work at SWI Lab, Georgia Tech.">
  <div class="container">
    <header class="page-heading-simple">
      <h1>Research</h1>
      {Intro && <div class="lead-body"><Intro /></div>}
    </header>

    {rendered.map(({ topic, Content }) => (
        <section id={topic.id} class="research-section section-anchor">
          <h2>{topic.data.title}</h2>
          <div class="research-body">
            {topic.data.tags.length > 0 && <ul class="tag-list" aria-label="Keywords">{topic.data.tags.map(tag => <li>{tag}</li>)}</ul>}
            <div class="research-description"><Content /></div>
          </div>
        </section>
    ))}

    <div class="research-bottom"><a href="/publications/">All publications</a><a href="/join/">Join us</a></div>
  </div>
</Base>
