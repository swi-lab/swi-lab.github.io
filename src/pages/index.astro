---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import WorldModel from '../components/WorldModel.astro';
const home = await getEntry('pages', 'home');
if (!home) throw new Error('src/content/pages/home.md is missing');
const { Content: Intro } = await render(home);
const recentNews = (await getCollection('news')).sort((a, b) => b.data.date.localeCompare(a.data.date)).slice(0, 5);
---
<Base>
  <section class="container hero" aria-labelledby="lab-name">
    <div class="hero-copy">
      <h1 id="lab-name">Science, World models <span>and Intelligence</span></h1>
      <div class="hero-body"><Intro /></div>
      <a class="section-more hero-more" href="/research/">Research topics</a>
    </div>
    <WorldModel />
  </section>

  {recentNews.length > 0 && (
    <section class="container section news-section" aria-labelledby="news-heading">
      <h2 id="news-heading">News</h2>
      <ul class="news-list">
        {recentNews.map(({ data: item }) => <li><time class="news-date" datetime={item.date}>{item.date}</time><span>{item.url ? <a href={item.url}>{item.text}</a> : item.text}</span></li>)}
      </ul>
    </section>
  )}

  {home.data.joinBlurb && (
    <section class="container section join-preview" aria-labelledby="join-heading">
      <h2 id="join-heading">Joining the lab</h2>
      <div>
        <p>{home.data.joinBlurb}</p>
        <a class="section-more" href="/join/">Information for prospective students and visitors</a>
      </div>
    </section>
  )}
</Base>
