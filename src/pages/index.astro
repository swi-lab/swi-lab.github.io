---
import Base from '../layouts/Base.astro';
import WorldModel from '../components/WorldModel.astro';
import { news, publications } from '../data/lab';
const recentNews = news.slice(0, 5);
const selected = publications.filter(paper => paper.selected);
---
<Base>
  <section class="container hero" aria-labelledby="lab-name">
    <div class="hero-copy">
      <h1 id="lab-name">Science, World models <span>and Intelligence</span></h1>
      <p class="hero-affiliation">A research group at Georgia Tech, led by Prof. <a href="/people/">Jiayun Wang</a>.</p>
      <p class="hero-text">We build generative models to study physical and biological systems. Our work connects world models, inverse problems, and medical imaging: reconstructing images from measurements, simulating systems, and predicting how they change.</p>
      <a class="section-more hero-more" href="/research/">Research topics</a>
    </div>
    <WorldModel />
  </section>

  {recentNews.length > 0 && (
    <section class="container section news-section" aria-labelledby="news-heading">
      <h2 id="news-heading">News</h2>
      <ul class="news-list">
        {recentNews.map(item => <li><time class="news-date" datetime={item.date}>{item.date}</time><span>{item.url ? <a href={item.url}>{item.text}</a> : item.text}</span></li>)}
      </ul>
    </section>
  )}

  {selected.length > 0 && (
    <section class="container section" aria-labelledby="selected-heading">
      <div class="section-heading">
        <h2 id="selected-heading">Selected publications</h2>
        <a href="/publications/" class="section-more">All publications</a>
      </div>
      <ol class="related-work">
        {selected.map(paper => (
          <li>
            <a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title}</a>
            <span class="related-meta">{paper.authors} · {paper.venue} {paper.year}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="container section join-preview" aria-labelledby="join-heading">
    <h2 id="join-heading">Joining the lab</h2>
    <div>
      <p>We welcome prospective PhD students, Georgia Tech undergraduate and master’s students, and visiting researchers.</p>
      <a class="section-more" href="/join/">Information for prospective students and visitors</a>
    </div>
  </section>
</Base>
