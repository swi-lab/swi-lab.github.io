---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const publications = (await getCollection('publications')).map(entry => entry.data);
const years = [...new Set(publications.map(paper => paper.year))].sort((a, b) => b - a);
---
<Base title="Publications" description="Publications from SWI Lab at Georgia Tech.">
  <div class="container">
    <header class="page-heading page-heading-simple"><h1>Publications</h1></header>
    <div class="page-content">
      {publications.length > 0 ? years.map(year => (
        <section class="publication-year">
          <h2>{year}</h2>
          {publications.filter(paper => paper.year === year).map(paper => (
            <article class="publication">
              {paper.image && <img src={paper.image} alt="" loading="lazy" />}
              <div>
                <h3><a href={paper.url} target="_blank" rel="noopener noreferrer">{paper.title}</a></h3>
                <p>{paper.authors}</p>
                <p>{paper.venue}, {paper.year}</p>
                <div class="publication-links">
                  <a href={paper.url} target="_blank" rel="noopener noreferrer">Paper</a>
                  {paper.code && <a href={paper.code} target="_blank" rel="noopener noreferrer">Code</a>}
                </div>
              </div>
            </article>
          ))}
        </section>
      )) : <p class="publication-empty">Publications will be listed here.</p>}
    </div>
  </div>
</Base>
