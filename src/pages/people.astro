---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Roles appear in this order; any other role is appended at the end.
const roleOrder = [
  'Principal Investigator',
  'Postdoctoral Researchers',
  'PhD Students',
  'Master’s Students',
  'Undergraduate Students',
  'Visiting Students',
  'Undergrads/Visitors',
  'Alumni',
];
const rank = (role: string) => { const i = roleOrder.indexOf(role); return i === -1 ? roleOrder.length : i; };

const members = (await getCollection('members'))
  .map(entry => entry.data)
  .sort((a, b) => rank(a.role) - rank(b.role) || (a.order ?? Infinity) - (b.order ?? Infinity) || a.name.localeCompare(b.name));
const groups = [...new Set(members.map(member => member.role))];
const initials = (name: string) => name.split(' ').map(part => part[0]).join('');
---
<Base title="People" description="Members of SWI Lab at Georgia Tech.">
  <div class="container">
    <header class="page-heading-simple"><h1>People</h1></header>
    <div class="page-content">
      {members.length > 0 ? groups.map(group => group === 'Alumni' ? (
        <section class="member-group">
          <h2>{group}</h2>
          <ul class="alumni-list">
            {members.filter(member => member.role === group).map(alum => (
              <li class="alum">
                <h3>{alum.url ? <a href={alum.url} target="_blank" rel="noopener noreferrer">{alum.name}</a> : alum.name}</h3>
                {(alum.bio || alum.coadvisors) && <p>{[alum.bio, alum.coadvisors && `co-advised with ${alum.coadvisors}`].filter(Boolean).join(', ')}</p>}
                {alum.now && <p class="alum-now"><span>Now:</span> {alum.now}</p>}
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <section class:list={['member-group', { 'member-group-pi': group === 'Principal Investigator' }]}>
          <h2>{group}</h2>
          <div class="members-grid">
            {members.filter(member => member.role === group).map(member => (
              <article class="member">
                {member.image ? (
                  <Image class="member-photo" src={member.image} alt={member.name} width={176} height={220} fit="cover" densities={[1, 2]} />
                ) : (
                  <div class="member-photo member-initials" aria-hidden="true">{initials(member.name)}</div>
                )}
                <div class="member-info">
                  <header class="member-heading">
                    <h3>{member.url ? <a href={member.url} target="_blank" rel="noopener noreferrer">{member.name}</a> : member.name}</h3>
                    {member.email && <a class="member-email" href={`mailto:${member.email}`}>{member.email}</a>}
                  </header>
                  {member.bio && <div class="member-bio">
                    {member.bio.trim().split(/\n\s*\n/).map(entry => <p>{entry}</p>)}
                  </div>}
                  {member.interests && <dl class="member-interests">
                    <dt>Research interests</dt>
                    <dd>{member.interests}</dd>
                  </dl>}
                </div>
              </article>
            ))}
          </div>
        </section>
      )) : <p class="publication-empty">Member profiles will be added soon.</p>}
    </div>
  </div>
</Base>
