---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

// Roles appear in this order; any other role is appended at the end.
const roleOrder = [
  'Principal Investigator',
  'Postdoctoral Researchers',
  'PhD Students',
  'Master’s Students',
  'Undergraduate Students',
  'Visiting Students',
  'Alumni',
];
const rank = (role: string) => { const i = roleOrder.indexOf(role); return i === -1 ? roleOrder.length : i; };

const members = (await getCollection('members'))
  .map(entry => entry.data)
  .sort((a, b) => rank(a.role) - rank(b.role) || (a.order ?? Infinity) - (b.order ?? Infinity) || a.name.localeCompare(b.name));
const groups = [...new Set(members.map(member => member.role))];
const initials = (name: string) => name.split(' ').map(part => part[0]).join('');
---
<Base title="People" description="Members of SWI Lab at Georgia Tech.">
  <div class="container">
    <header class="page-heading-simple"><h1>People</h1></header>
    <div class="page-content">
      {members.length > 0 ? groups.map(group => (
        <section class:list={['member-group', { 'member-group-pi': group === 'Principal Investigator' }]}>
          <h2>{group}</h2>
          <div class="members-grid">
            {members.filter(member => member.role === group).map(member => (
              <article class="member">
                {member.image ? (
                  <img class="member-photo" src={member.image} alt={member.name} width="280" height="350" loading="lazy" />
                ) : (
                  <div class="member-photo member-initials" aria-hidden="true">{initials(member.name)}</div>
                )}
                <div class="member-info">
                  <header class="member-heading">
                    <h3>{member.url ? <a href={member.url}>{member.name}</a> : member.name}</h3>
                    <a class="member-email" href={`mailto:${member.email}`}>{member.email}</a>
                  </header>
                  <p class:list={['member-bio', { 'member-placeholder': !member.bio }]}>
                    {member.bio || 'Biography forthcoming.'}
                  </p>
                  <dl class="member-interests">
                    <dt>Research interests</dt>
                    <dd class:list={{ 'member-placeholder': !member.interests }}>{member.interests || 'To be added.'}</dd>
                  </dl>
                </div>
              </article>
            ))}
          </div>
        </section>
      )) : <p class="publication-empty">Member profiles will be added soon.</p>}
    </div>
  </div>
</Base>
