---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
const site = (await getEntry('site', 'site'))?.data;
const page = await getEntry('pages', 'join');
if (!site || !page) throw new Error('src/content/site.toml or src/content/pages/join.md is missing');
const { Content } = await render(page);
---
<Base title="Join us" description="Information for prospective students, visiting students, and research interns at SWI Lab @ Georgia Tech.">
  <div class="container">
    <header class="page-heading page-heading-simple"><h1>Join us</h1></header>
    <div class="page-content join-content">
      <div class="markdown"><Content /></div>
      <section class="join-contact" aria-labelledby="contact-information">
        <h2 id="contact-information">Contact information</h2>
        <address>
          <span>{site.pi}</span>
          <span>{site.brand}</span>
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </address>
      </section>
    </div>
  </div>
</Base>
