---
import { WAVE_ROWS, wavePath, waveOpacity } from './wave-field';
const curves = Array.from({ length: WAVE_ROWS }, (_, row) => ({ d: wavePath(row), opacity: waveOpacity(row) }));
---
<figure class="world-figure">
  <div class="world-panel">
    <svg class="wave-field" viewBox="0 18 440 208" role="img" aria-labelledby="wave-title">
      <title id="wave-title">Schematic of a changing physical system, represented by a family of waves.</title>
      <defs>
        <linearGradient id="wave-color" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#d4b16c" />
          <stop offset="55%" stop-color="#ecdcad" />
          <stop offset="100%" stop-color="#73afbc" />
        </linearGradient>
      </defs>
      <g stroke="#a0acb5" stroke-opacity=".09" stroke-width=".6">
        {[44, 88, 132, 176, 220, 264, 308, 352, 396].map(x => <path d={`M${x} 18V228`} />)}
        {[44, 88, 132, 176, 220].map(y => <path d={`M12 ${y}H428`} />)}
      </g>
      <g class="wave-lines" fill="none" stroke="url(#wave-color)" stroke-width="1.25">
        {curves.map(curve => <path d={curve.d} opacity={curve.opacity} />)}
      </g>
    </svg>
    <div class="model-chain">
      <div class="chain-node"><span class="chain-name">Observations</span><span class="chain-note">Partial, noisy data</span></div>
      <div class="chain-link"><span><span aria-hidden="true">↓</span> infer</span><span><span aria-hidden="true">↑</span> generate</span></div>
      <div class="chain-node chain-model"><span class="chain-name">Representation</span><span class="chain-note">Underlying system</span></div>
      <div class="chain-link"><span><span aria-hidden="true">↓</span> simulate</span></div>
      <div class="chain-node"><span class="chain-name">Dynamics</span><span class="chain-note">How it evolves</span></div>
    </div>
  </div>
</figure>

<script>
  // Let the waves drift slowly. Skipped when the viewer prefers reduced motion,
  // and paused while the figure is off screen.
  import { wavePath } from './wave-field';
  const field = document.querySelector<SVGSVGElement>('.wave-field');
  const paths = field ? [...field.querySelectorAll<SVGPathElement>('.wave-lines path')] : [];
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let frame = 0;
  let start: number | undefined;
  function draw(time: number) {
    start ??= time;
    const phase = (time - start) / 1000 * .35;
    paths.forEach((path, row) => path.setAttribute('d', wavePath(row, phase)));
    frame = requestAnimationFrame(draw);
  }
  function stop() { cancelAnimationFrame(frame); frame = 0; }
  if (field && paths.length > 0) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !reduceMotion.matches && !frame) frame = requestAnimationFrame(draw);
      else if (!entry.isIntersecting) stop();
    }).observe(field);
    reduceMotion.addEventListener('change', () => { if (reduceMotion.matches) stop(); });
  }
</script>

<style>
  .world-figure {
    min-width: 0;
    width: 100%;
  }
  .world-panel {
    padding: 22px 24px 20px;
    background: #1a2b38;
    color: #f2f1eb;
  }
  .wave-field { display: block; width: 100%; height: auto; margin-bottom: 18px; }
  .model-chain { display: grid; gap: 2px; padding-top: 16px; border-top: 1px solid #ffffff2b; }
  .chain-node { position: relative; display: flex; align-items: baseline; gap: 8px; padding-left: 22px; line-height: 1.55; }
  .chain-node::before { content: ''; position: absolute; left: 3px; top: .5em; width: 7px; height: 7px; border: 1.5px solid #cbd6df; border-radius: 50%; background: #1a2b38; }
  .chain-model::before { border-color: #e1c895; background: #e1c895; box-shadow: 0 0 0 4px #e1c89526; }
  .chain-name { flex: 0 0 8.6em; font-size: 15px; font-weight: 500; }
  .chain-model .chain-name { color: #e1c895; }
  .chain-note { min-width: 0; font-size: 13px; color: #a9b8c4; }
  .chain-link { position: relative; display: flex; gap: 16px; padding: 1px 0 1px 22px; font-size: 12px; line-height: 1.5; color: #8fa1ae; }
  .chain-link::before { content: ''; position: absolute; left: 8px; top: -7px; bottom: -7px; width: 1px; background: #ffffff38; }
  .chain-link > span { white-space: nowrap; }
  .chain-link [aria-hidden] { color: #e1c895; }
  @media (max-width: 380px) {
    .world-panel { padding: 16px; }
    .chain-name { flex-basis: 8em; font-size: 14px; }
    .chain-note { font-size: 12px; }
  }
  @media print {
    .world-figure { break-inside: avoid; print-color-adjust: exact; }
  }
</style>
