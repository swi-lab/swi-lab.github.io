---
import { WAVE_ROWS, WAVE_LAYERS, FUTURE_STEPS, observationPath, curvePath, waveOpacity } from './wave-field';
const rows = Array.from({ length: WAVE_ROWS }, (_, row) => row);
---
<figure class="world-figure">
  <div class="world-panel">
    <div class="wave-stage">
      <svg class="wave-field" viewBox="0 18 440 212" role="img" aria-labelledby="wave-title">
        <title id="wave-title">Sparse, noisy observations on the left resolve into a smooth family of curves, which on the right is rolled forward in time.</title>
        <defs>
          {Object.entries(WAVE_LAYERS).map(([name, layer]) => (
            <linearGradient id={`${name}-stroke`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="440" y2="0">
              {layer.stops.map(([x, color, opacity]) => <stop offset={x / 440} stop-color={color} stop-opacity={opacity} />)}
            </linearGradient>
          ))}
        </defs>
        <g stroke="#a0acb5" stroke-opacity=".09" stroke-width=".6">
          {[44, 88, 132, 176, 220, 264, 308, 352, 396].map(x => <path d={`M${x} 18V228`} />)}
          {[44, 88, 132, 176, 220].map(y => <path d={`M12 ${y}H428`} />)}
        </g>
        <g class="wave-layers" fill="none" stroke-linecap="round">
          <g stroke="url(#data-stroke)" stroke-width={WAVE_LAYERS.data.width}>
            {rows.map(row => <path d={observationPath(row)} stroke-opacity={waveOpacity(row)} />)}
          </g>
          <g stroke="url(#future-stroke)" stroke-width={WAVE_LAYERS.future.width}>
            {rows.flatMap(row => FUTURE_STEPS.map(step => <path d={curvePath(row, 0, 280, 440, step.ahead)} stroke-opacity={waveOpacity(row) * step.opacity} />))}
          </g>
          <g stroke="url(#model-stroke)" stroke-width={WAVE_LAYERS.model.width}>
            {rows.map(row => <path d={curvePath(row)} stroke-opacity={waveOpacity(row)} />)}
          </g>
        </g>
      </svg>
      <canvas class="wave-canvas" aria-hidden="true"></canvas>
    </div>
    <div class="wave-labels" aria-hidden="true"><span>observations</span><span>representation</span><span>dynamics</span></div>
    <div class="model-chain">
      <div class="chain-node"><span class="chain-name">Observations</span><span class="chain-note">Partial, noisy data</span></div>
      <div class="chain-link"><span><span aria-hidden="true">↓</span> infer</span><span><span aria-hidden="true">↑</span> generate</span></div>
      <div class="chain-node chain-model"><span class="chain-name">Representation</span><span class="chain-note">Underlying system</span></div>
      <div class="chain-link"><span><span aria-hidden="true">↓</span> simulate</span></div>
      <div class="chain-node"><span class="chain-name">Dynamics</span><span class="chain-note">How it evolves</span></div>
    </div>
  </div>
</figure>

<script>
  // Let the waves drift slowly (observations, curves and future states together). Once moving
  // they are drawn on the canvas laid over the SVG, whose own wave layers are then hidden:
  // redrawing ~90 gradient-stroked SVG paths every frame is too slow on many GPUs.
  // Skipped when the viewer prefers reduced motion, and paused while off screen.
  import { WAVE_ROWS, WAVE_LAYERS, FUTURE_STEPS, observationPoints, curvePoints, waveOpacity } from './wave-field';
  const stage = document.querySelector<HTMLElement>('.wave-stage');
  const canvas = stage?.querySelector('canvas');
  const ctx = canvas?.getContext('2d');
  if (stage && canvas && ctx) animate(stage, canvas, ctx);

  function animate(stage: HTMLElement, canvas: HTMLCanvasElement, ctx: CanvasRenderingContext2D) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    // The SVG gradient stops, with each stop's opacity folded into its colour as hex alpha.
    const gradient = (layer: keyof typeof WAVE_LAYERS) => {
      const paint = ctx.createLinearGradient(0, 0, 440, 0);
      for (const [x, color, opacity] of WAVE_LAYERS[layer].stops) {
        paint.addColorStop(x / 440, color + Math.round(opacity * 255).toString(16).padStart(2, '0'));
      }
      return paint;
    };
    const paint = { data: gradient('data'), future: gradient('future'), model: gradient('model') };
    const trace = (points: [number, number][]) => {
      ctx.beginPath();
      points.forEach(([x, y], i) => i === 0 ? ctx.moveTo(x, y) : ctx.lineTo(x, y));
      ctx.stroke();
    };

    function render(phase: number) {
      // Map the SVG's viewBox (0 18 440 212) onto the canvas. Resizing the canvas resets its
      // state, so everything is set afresh each frame.
      const scale = canvas.width / 440;
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      ctx.setTransform(scale, 0, 0, scale, 0, -18 * scale);
      ctx.lineCap = 'round';
      // Observations are dots, as wide as the SVG's round-capped stroke.
      const radius = WAVE_LAYERS.data.width / 2;
      ctx.fillStyle = paint.data;
      for (let row = 0; row < WAVE_ROWS; row++) {
        ctx.globalAlpha = waveOpacity(row);
        ctx.beginPath();
        for (const [x, y] of observationPoints(row, phase)) {
          ctx.moveTo(x + radius, y);
          ctx.arc(x, y, radius, 0, 2 * Math.PI);
        }
        ctx.fill();
      }
      ctx.strokeStyle = paint.future;
      ctx.lineWidth = WAVE_LAYERS.future.width;
      for (let row = 0; row < WAVE_ROWS; row++) {
        for (const step of FUTURE_STEPS) {
          ctx.globalAlpha = waveOpacity(row) * step.opacity;
          trace(curvePoints(row, phase, 280, 440, step.ahead));
        }
      }
      ctx.strokeStyle = paint.model;
      ctx.lineWidth = WAVE_LAYERS.model.width;
      for (let row = 0; row < WAVE_ROWS; row++) {
        ctx.globalAlpha = waveOpacity(row);
        trace(curvePoints(row, phase));
      }
    }

    let frame = 0;
    let phase = 0;
    let last: number | undefined;
    function tick(time: number) {
      // Advance by the time since the last frame, capped so that a stalled frame or a return
      // from off screen doesn't make the waves jump.
      phase += Math.min(time - (last ?? time), 100) / 1000 * .35;
      last = time;
      render(phase);
      stage.classList.add('is-live');
      frame = requestAnimationFrame(tick);
    }
    function stop() { cancelAnimationFrame(frame); frame = 0; last = undefined; }

    new ResizeObserver(([entry]) => {
      canvas.width = Math.round(entry.contentRect.width * devicePixelRatio);
      canvas.height = Math.round(entry.contentRect.height * devicePixelRatio);
      if (stage.classList.contains('is-live')) render(phase);
    }).observe(canvas);
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting && !reduceMotion.matches && !frame) frame = requestAnimationFrame(tick);
      else if (!entry.isIntersecting) stop();
    }).observe(stage);
    reduceMotion.addEventListener('change', () => { if (reduceMotion.matches) stop(); });
  }
</script>

<style>
  .world-figure {
    min-width: 0;
    width: 100%;
  }
  .world-panel {
    padding: 22px 24px 20px;
    background: #1a2b38;
    color: #f2f1eb;
  }
  .wave-stage { position: relative; }
  .wave-field { display: block; width: 100%; height: auto; }
  .wave-canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .is-live .wave-layers { visibility: hidden; }
  /* Columns centred under the three regions of the wave field (15%, 50%, 85% across). */
  .wave-labels { display: grid; grid-template-columns: 30% 40% 30%; margin: 6px 0 18px; font-size: 12px; line-height: 1.4; text-align: center; color: #8fa1ae; }
  .model-chain { display: grid; gap: 2px; padding-top: 16px; border-top: 1px solid #ffffff2b; }
  .chain-node { position: relative; display: flex; align-items: baseline; gap: 8px; padding-left: 22px; line-height: 1.55; }
  .chain-node::before { content: ''; position: absolute; left: 3px; top: .5em; width: 7px; height: 7px; border: 1.5px solid #cbd6df; border-radius: 50%; background: #1a2b38; }
  .chain-model::before { border-color: #e1c895; background: #e1c895; box-shadow: 0 0 0 4px #e1c89526; }
  .chain-name { flex: 0 0 8.6em; font-size: 15px; font-weight: 500; }
  .chain-model .chain-name { color: #e1c895; }
  .chain-note { min-width: 0; font-size: 13px; color: #a9b8c4; }
  .chain-link { position: relative; display: flex; gap: 16px; padding: 1px 0 1px 22px; font-size: 12px; line-height: 1.5; color: #8fa1ae; }
  .chain-link::before { content: ''; position: absolute; left: 8px; top: -7px; bottom: -7px; width: 1px; background: #ffffff38; }
  .chain-link > span { white-space: nowrap; }
  .chain-link [aria-hidden] { color: #e1c895; }
  @media (max-width: 380px) {
    .world-panel { padding: 16px; }
    .chain-name { flex-basis: 8em; font-size: 14px; }
    .chain-note { font-size: 12px; }
  }
  @media print {
    .world-figure { break-inside: avoid; print-color-adjust: exact; }
  }
</style>
