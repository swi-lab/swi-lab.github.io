---
const curves = Array.from({ length: 22 }, (_, row) => {
  const points = Array.from({ length: 101 }, (_, col) => {
    const x = col * 4.4;
    const envelope = Math.exp(-Math.pow((x - 234) / 124, 2));
    const y = 54 + row * 6.8 + Math.sin(x / 39 + row * .19) * envelope * (23 + 17 * Math.sin(row / 7));
    return `${col === 0 ? 'M' : 'L'}${x.toFixed(1)},${y.toFixed(1)}`;
  }).join(' ');
  return { d: points, opacity: .22 + .64 * Math.sin((row + 1) / 24 * Math.PI) };
});
---
<figure class="world-figure">
  <div class="world-panel">
    <svg class="wave-field" viewBox="0 18 440 208" role="img" aria-labelledby="wave-title">
      <title id="wave-title">Schematic of a changing physical system, represented by a family of waves.</title>
      <defs>
        <linearGradient id="wave-color" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#d4b16c" />
          <stop offset="55%" stop-color="#ecdcad" />
          <stop offset="100%" stop-color="#73afbc" />
        </linearGradient>
      </defs>
      <g stroke="#a0acb5" stroke-opacity=".09" stroke-width=".6">
        {[44, 88, 132, 176, 220, 264, 308, 352, 396].map(x => <path d={`M${x} 18V228`} />)}
        {[44, 88, 132, 176, 220].map(y => <path d={`M12 ${y}H428`} />)}
      </g>
      <g fill="none" stroke="url(#wave-color)" stroke-width="1.25">
        {curves.map(curve => <path d={curve.d} opacity={curve.opacity} />)}
      </g>
    </svg>
    <div class="model-diagram">
      <div class="diagram-node">Observations<span>Measurements<br />and images</span></div>
      <div class="diagram-arrows">
        <span>infer <span aria-hidden="true">→</span></span>
        <span><span aria-hidden="true">←</span> generate</span>
      </div>
      <div class="diagram-node model-node">World model<span>Structure<br />and dynamics</span></div>
    </div>
  </div>
  <figcaption>Forward simulation and inverse inference</figcaption>
</figure>

<style>
  .world-figure {
    min-width: 0;
    width: 100%;
  }
  .world-panel {
    padding: 22px 24px 20px;
    background: #1a2b38;
    color: #f2f1eb;
  }
  .wave-field { display: block; width: 100%; height: auto; margin-bottom: 20px; }
  .model-diagram {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 86px minmax(0, 1fr);
    align-items: center;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid #ffffff35;
  }
  .diagram-node { font-size: 16px; font-weight: 500; line-height: 1.4; }
  .diagram-node > span { display: block; margin-top: 8px; font-size: 13px; font-weight: 400; line-height: 1.6; color: #cbd6df; }
  .model-node { text-align: right; color: #e1c895; }
  .diagram-arrows { display: grid; gap: 12px; font-size: 13px; line-height: 1.5; text-align: center; color: #d1dbe2; }
  .diagram-arrows > span { white-space: nowrap; }
  .diagram-arrows > span:first-child { color: #e1c895; }
  figcaption { padding-top: 12px; font-size: 13px; line-height: 1.6; color: var(--muted); }
  @media (max-width: 380px) {
    .world-panel { padding: 16px; }
    .model-diagram { grid-template-columns: minmax(0, 1fr) 68px minmax(0, 1fr); gap: 6px; }
    .diagram-node { font-size: 14px; }
    .diagram-node > span, .diagram-arrows { font-size: 12px; }
  }
  @media print {
    .world-figure { break-inside: avoid; print-color-adjust: exact; }
  }
</style>
